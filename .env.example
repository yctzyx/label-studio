# Label Studio - Environment Configuration Example
# Copy to .env and adjust values as needed.
# Environment variables support prefixes: LABEL_STUDIO_, HEARTEX_, or plain name.

# ============== Nacos Service Registration ==============
# Nacos server address (host:port). Set empty to disable registration.
NACOS_SERVER_ADDR=192.168.1.76:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_SERVICE_NAME=label-studio
NACOS_GROUP_NAME=DEFAULT_GROUP
NACOS_NAMESPACE_ID=public
# Instance IP to register (leave empty to auto-detect)
# NACOS_IP=

# ============== Django / Server ==============
# DJANGO_DB=sqlite
# HOST=http://localhost:8080
# PORT=8080
# DEBUG=true
# LOG_LEVEL=DEBUG

# ============== 无界 / 网关嵌入 ==============
# 首屏直连 LS（/embed/），后续 API 走网关时，前端请求的 base URL。需与网关 path 一致。
# 例如网关 path 为 /api/label-studio/** 时，设为：http(s)://网关地址/api/label-studio
# EMBED_GATEWAY_HOSTNAME=http://172.16.25.137:9000/api/label-studio
# 网关将请求头 jwt-user（Base64 编码的用户信息 JSON）转发给 LS 时，LS 会解析并映射用户。
# 同时存在 embed 直连 LS 与 API 经网关时：设 CORS_DISABLED=false，并指定允许的 origin。
# LS 会为直连请求加 CORS；经网关的请求会自动移除 LS 的 CORS 头，避免与网关重复。
# CORS_DISABLED=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============== 父平台表直连（data_database / md_data_set） ==============
# 表在 Label Studio 同一 MySQL 库时：只需 DJANGO_DB=mysql 且表已存在，不必配置下列项。
# 表在独立 MySQL 库时：设置库名（必选）及连接信息。
# PARENT_PLATFORM_MYSQL_NAME=parent_platform_db
# PARENT_PLATFORM_MYSQL_HOST=127.0.0.1
# PARENT_PLATFORM_MYSQL_PORT=3306
# PARENT_PLATFORM_MYSQL_USER=root
# PARENT_PLATFORM_MYSQL_PASSWORD=

# ============== 父平台目录同步（pub_org / pub_user / pub_user_org） ==============
# 三张表已与 Label Studio 在同一 MySQL 库时保持默认即可（不配 PUB_DIRECTORY_MYSQL_NAME）：
# PUB_DIRECTORY_DB=default
# 若人员目录在独立 MySQL 库，配置专用连接（表名固定：pub_org / pub_user / pub_user_org）：
# PUB_DIRECTORY_MYSQL_NAME=parent_directory_db
# PUB_DIRECTORY_MYSQL_HOST=127.0.0.1
# PUB_DIRECTORY_MYSQL_PORT=3306
# PUB_DIRECTORY_MYSQL_USER=root
# PUB_DIRECTORY_MYSQL_PASSWORD=
# 可选：目录同步库引擎。默认使用兼容 MySQL 5.7 的后端（仅建议用于该只读同步库）。
# PUB_DIRECTORY_MYSQL_ENGINE=core.db.backends.mysql57
# 可选：直接指定读取别名（默认：配置了 PUB_DIRECTORY_MYSQL_NAME 就读 pub_directory；否则读 default）
# PUB_DIRECTORY_DB=pub_directory
# 定时同步（runserver 进程内后台线程）
# PUB_DIRECTORY_SYNC_ENABLED=true
# PUB_DIRECTORY_SYNC_INTERVAL_SECONDS=60
# PUB_DIRECTORY_SYNC_PRUNE_MEMBERSHIPS=false
# 同步命令：python label_studio/manage.py sync_pub_directory
# 演练：python label_studio/manage.py sync_pub_directory --dry-run
# 可选：移除父平台已删除的关联（仅作用于带 external_* 的成员行）
# python label_studio/manage.py sync_pub_directory --prune-memberships

# 父平台对象存储（S3 兼容，用于「同步」列举桶内对象）：当 data_database.config_json 未配置 s3_endpoint 时使用
# PARENT_PLATFORM_S3_DEFAULT_ENDPOINT=http://minio-host:9000
# PARENT_PLATFORM_S3_PORT=9000
# PARENT_PLATFORM_S3_USE_SSL=false
# PARENT_PLATFORM_S3_REGION=us-east-1
