# Service port exposed on host.
GROUNDING_DINO_BACKEND_PORT=9092

# Runtime tuning.
LOG_LEVEL=INFO
WORKERS=1
THREADS=4

# Label Studio connection. Required when tasks contain protected/local images.
# Docker Desktop / Linux Docker bridge: use host.docker.internal for host Label Studio.
LABEL_STUDIO_URL=http://host.docker.internal:8080
LABEL_STUDIO_API_KEY=
# Compatibility aliases used by upstream label-studio-ml-backend examples.
LABEL_STUDIO_HOST=http://host.docker.internal:8080
LABEL_STUDIO_ACCESS_TOKEN=

# Grounding DINO model files inside the container.
GROUNDINGDINO_REPO_PATH=/GroundingDINO
GROUNDING_DINO_CONFIG=GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_WEIGHTS=groundingdino_swint_ogc.pth

# Default inference parameters. Project UI controls can override them.
# When enabled, prompt is generated from RectangleLabels / predicted_values if DEFAULT_PROMPT is empty.
AUTO_PROMPT_FROM_LABELS=1
DEFAULT_PROMPT=
BOX_THRESHOLD=0.30
TEXT_THRESHOLD=0.25
