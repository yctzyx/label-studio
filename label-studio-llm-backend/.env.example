# Service port exposed on host (Label Studio UI defaults to http://localhost:9090)
LLM_BACKEND_PORT=9090

# Optional fallback when project UI does not pass api_key via extra_params
OPENAI_API_KEY=

# Legacy env defaults (UI extra_params take precedence after /setup)
OPENAI_PROVIDER=openai
OPENAI_MODEL=
LOG_LEVEL=INFO
PROMPT_PREFIX=prompt
USE_INTERNAL_PROMPT_TEMPLATE=0
NUM_RESPONSES=1
TEMPERATURE=0.7

# Label Studio connection（图片/本地上传任务必填，用于 ML 后端读取任务中的图片）
# 本地开发：Django 在宿主机 8080，ML 在 Docker 里用 host.docker.internal
LABEL_STUDIO_URL=http://host.docker.internal:8080
# JWT API Token（推荐）：Label Studio → 账户与设置 → API Tokens → 创建
# 若组织已禁用 Legacy Token，勿再使用旧版 Access Token（会 403）
# 新版 Label Studio 会在预测时自动内联父平台图片，通常无需配置此项
LABEL_STUDIO_API_KEY=

# Azure (only when provider=azure in project settings)
AZURE_RESOURCE_ENDPOINT=
AZURE_DEPLOYMENT_NAME=
AZURE_API_VERSION=2024-02-15

# Ollama (only when provider=ollama in project settings)
OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1
